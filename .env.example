# ============================================================================
# Environment Variables Template
# ============================================================================
# Copy this file: cp .env.example .env
# Then fill in your actual values.
#
# NEVER commit .env to git! It contains secrets.
# The .gitignore file already excludes it.

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# S3 Buckets
RAW_IMAGES_BUCKET=product-images-raw
PROCESSED_IMAGES_BUCKET=product-images-processed
MODEL_ARTIFACTS_BUCKET=ml-model-artifacts

# SageMaker
SAGEMAKER_ROLE_ARN=arn:aws:iam::123456789012:role/SageMakerExecutionRole
SAGEMAKER_ENDPOINT_NAME=product-classifier
TRAINING_INSTANCE_TYPE=ml.g4dn.xlarge
INFERENCE_INSTANCE_TYPE=ml.m5.large

# DynamoDB
DYNAMODB_TABLE_NAME=product-predictions

# Monitoring
SNS_ALERT_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:ml-pipeline-alerts
ALERT_EMAIL=your-email@example.com

# Environment
ENVIRONMENT=dev
